NODE_ENV=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173,https://reunitee.pages.dev

# PostgreSQL Database Connection String (or Supabase direct connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Authentication & JWT
JWT_SECRET=reunite-super-secure-jwt-secret-key-2025
JWT_EXPIRES_IN_DAYS=7
AUTH_COOKIE_NAME=reunite_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Supabase Storage for Photos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=Photos

# Hugging Face AI Space (512-d Siamese Model)
AI_SPACE=Eureka-up/Reunite-AI
AI_TOKEN=
AI_API_NAME=/embed
EMBEDDING_DIM=512
